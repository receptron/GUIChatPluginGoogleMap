{
  "name": "@gui-chat-plugin/google-map",
  "version": "2.1.0",
  "type": "module",
  "description": "Google Map location plugin for GUI Chat applications",
  "author": "receptron",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "quality": "scoria",
    "format": "prettier --write \"{src,demo}/**/*.{ts,tsx,vue,json,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"{src,demo}/**/*.{ts,tsx,vue,json,css}\" \"*.{ts,js,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.67.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.13.0",
    "gui-chat-protocol": "^2.3.0",
    "openai": "^7.63.0",
    "prettier": "^3.10.1",
    "scoria": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue": "^3.5.46",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "gui-chat-protocol": "^2.3.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "resolutions": {
    "minimatch": "^11.0.5"
  },
  "dependencies": {}
}
